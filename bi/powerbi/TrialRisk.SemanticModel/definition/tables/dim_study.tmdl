table dim_study
	lineageTag: b832abb7-e4e0-5f33-aa4d-b50bb6936d24

	/// Studies in the current filter context.
	measure 'Trial Count' = DISTINCTCOUNT(dim_study[nct_id])
		formatString: #,0
		lineageTag: 6a5f54a2-35d8-5b4e-97c1-6730dd47d647

	/// RECRUITING or NOT_YET_RECRUITING studies.
	measure 'Open Trial Count' = CALCULATE(DISTINCTCOUNT(dim_study[nct_id]), dim_study[is_open] = TRUE())
		formatString: #,0
		lineageTag: 734ab6fd-236d-5cf7-bae5-cf8503220640

	column nct_id
		dataType: string
